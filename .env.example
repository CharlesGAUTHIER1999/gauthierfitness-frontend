# Base URL de l'API Laravel.
# Laisser vide en dev : axios tape /api en relatif et le proxy Vite (vite.config.js)
# redirige vers http://localhost:8000.
# En staging/prod, mettre l'URL complète : ex VITE_API_URL=https://api.gauthierfitness.fr/api
VITE_API_URL=

# Clé publique Stripe (pk_test_... en dev, pk_live_... en prod).
# Récupérer dans Stripe Dashboard > Developers > API keys.
VITE_STRIPE_PUBLIC_KEY=

# DSN Sentry (projet React) — laisser vide désactive le monitoring (local/CI)
VITE_SENTRY_DSN=
